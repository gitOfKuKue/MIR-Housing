meta {
  name: Upload Property Image
  type: http
  seq: 10
}

post {
  url: {{base_url}}/{{version}}/properties/5ca6e7d7-d487-4d1b-abd9-0241226235a3/images
  body: multipartForm
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  sort_order: 0
  files: @file(/Users/kukue/Desktop/Saigon-Pearl-tong-the-0-1.jpg|/Users/kukue/Desktop/maxresdefault.jpg|/Users/kukue/Desktop/20201127114221-4fef.jpg) @contentType(multipart/mixed)
}

vars:post-response {
  imageId: res.body.image.id
  imageUrl: res.body.public_url
}

tests {
  test("should return 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("should return image metadata", function() {
    expect(res.getBody().image).to.be.an("object");
    expect(res.getBody().image.property_id).to.equal(bru.getEnvVar("propertyId"));
    expect(res.getBody().image.storage_path).to.be.a("string");
    expect(res.getBody().public_url).to.be.a("string");
    expect(res.getBody().public_url.length).to.be.greaterThan(0);
  });
}

docs {
  Upload a property cover image to Supabase Storage via the Nest API.
  Run Login and Create Property first so accessToken and propertyId are set.
  Replace the @file(...) path with any local JPEG, PNG, or WebP under 5 MB.
  Requires migration 005_property_images.sql applied in Supabase.
}
