meta {
  name: Upsert Property Rooms
  type: http
  seq: 9
}

put {
  url: {{base_url}}/{{version}}/properties/{{propertyId}}/furnishings
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "amenities": [
      "elevator",
      "motorbike_parking",
      "security_guard"
    ],
    "rooms": [
