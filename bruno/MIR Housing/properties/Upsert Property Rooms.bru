}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return furnishings view for primary room", function() {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.property_id).to.equal(bru.getEnvVar("propertyId"));
    expect(body.has_air_conditioner).to.equal(true);
  });
}

docs {
  Upserts building amenities and multiple rooms for an existing property.

  Run after Create Property (uses propertyId).
  Omitting a previously saved room id soft-deletes that room.
  Include room.id when updating an existing room.

  amenities: elevator | security_guard | car_parking | motorbike_parking |
    ev_parking | pet_friendly | foreigner_friendly | cleaning_service

  room furnishings: air_conditioner | fridge | wardrobe | upper_kitchen_cabinet |
    lower_kitchen_cabinet | kitchen_counter | mattress | bed | shoe_cabinet |
    window_outdoor_view | window_corridor | window_air_well | balcony |
    ventilation_window | dining_table | desk | dressing_table | sofa | tv |
    range_hood | water_heater
}
