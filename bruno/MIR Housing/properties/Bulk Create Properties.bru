meta {
  name: Bulk Create Properties
  type: http
  seq: 12
}

post {
  url: {{base_url}}/{{version}}/properties/bulk
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{accessToken}}
}

