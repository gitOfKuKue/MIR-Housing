tests {
  test("should return 200 or 201", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
  
  test("should return created properties", function() {
    expect(res.getBody().data).to.be.an("array");
    expect(res.getBody().meta.created).to.equal(res.getBody().data.length);
    expect(res.getBody().meta.created).to.be.greaterThan(0);
  });
}

docs {
  Bulk import properties. Body: { "properties": [ ... ] }
  For all 20 HCMC properties run: npm run seed:properties
}
