meta {
  name: Create Property
  type: http
  seq: 8
}

post {
  url: {{base_url}}/{{version}}/properties
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "MIR Go Vap Building A",
    "property_type": "apartment",
    "status": "available",
    "address_line1": "145/12A Quang Trung",
    "address_line2": null,
    "city": "Ho Chi Minh City",
    "province": "Ho Chi Minh",
    "district": "Go Vap",
    "ward": "Ward 11",
    "street": "Quang Trung",
    "postal_code": "700000",
    "country": "VN",
    "rent_currency": "VND",
    "description": "Building with multiple rentable rooms.",
    "internal_notes": "Building with multiple rentable rooms.",
    "zalo_group_link": "https://zalo.me/g/example",
    "fee_electricity": "3500",
    "fee_water": "90000",
    "fee_water_type": "per_m3",
    "fee_motorbike": "100000",
    "fee_wifi": "100000",
    "fee_management": "200000"
  }
}

vars:post-response {
  propertyId: res.body.id
}

tests {
  test("should return 201 or 200", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });

  test("should return created property", function() {
    const body = res.getBody();
    expect(body.id).to.be.a("string");
    expect(body.name).to.equal("MIR Go Vap Building A");
    expect(body.status).to.equal("available");
    expect(body.city).to.equal("Ho Chi Minh City");
  });
}

docs {
  Creates a property (building) and saves id to propertyId.
  Room units are added next with Upsert Property Rooms (PUT .../furnishings).
  Room fields (rent, bedrooms, floor, etc.) are not stored on properties.
}
