meta {
  name: Change Password
  type: http
  seq: 6
}

post {
  url: {{base_url}}/{{version}}/auth/change-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "current_password": "Hello@2026#",
    "new_password": "Makeitnow@2026#"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("password", bru.getEnvVar("newPassword"));
  }
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("should return success message", function() {
    expect(res.getBody().message).to.equal("Password updated successfully");
  });
}

docs {
  Changes the authenticated user's password. Run Login first.
  
  Set `password` (current) and `newPassword` in the local environment.
  On success, `password` is updated to `newPassword` so Login still works.
}
