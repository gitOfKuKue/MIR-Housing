meta {
  name: Change Password - Same Password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/{{version}}/auth/change-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "current_password": "{{password}}",
    "new_password": "{{password}}"
  }
}

tests {
  test("should return 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("should reject same password", function() {
    expect(res.getBody().message).to.equal(
      "New password must be different from current password"
    );
  });
}

docs {
  Expects 400 when new_password matches current_password. Run Login first.
}
