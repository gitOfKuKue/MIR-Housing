meta {
  name: Change Password - Unauthorized
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/{{version}}/auth/change-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "current_password": "{{password}}",
    "new_password": "{{newPassword}}"
  }
}

tests {
  test("should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Expects 401 when no Bearer token is provided.
}
