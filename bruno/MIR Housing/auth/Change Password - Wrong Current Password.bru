meta {
  name: Change Password - Wrong Current Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/{{version}}/auth/change-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "current_password": "wrong-current-password",
    "new_password": "{{newPassword}}"
  }
}

tests {
  test("should return 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("should return incorrect password message", function() {
    expect(res.getBody().message).to.equal("Current password is incorrect");
  });
}

docs {
  Expects 401 when current_password is wrong. Run Login first.
}
