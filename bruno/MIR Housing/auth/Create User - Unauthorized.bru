meta {
  name: Create User - Unauthorized
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/{{version}}/auth/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "unauthorized-user@example.com",
    "password": "Welcome@2026!!!",
    "role": "contributor"
  }
}

tests {
  test("should return 401 without token", function() {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Expects 401 when no Bearer token is provided.
}
